# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_

# Canonical origin used in links and installers
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily cleanup cron (/api/cron/cleanup) sends this as a bearer token
CRON_SECRET=change-me

# Optional
# NEXT_PUBLIC_REMOTION_LICENSE_KEY=   # required by Remotion for companies above its free tier
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_HINGLISH_DISABLED=1     # hide the Hindi / Hinglish speech model
# GUEST_STALE_DAYS=7
# STORAGE_FILE_DAYS=7
# COMPANIONS_ENABLED=1                # allow the optional desktop helper to pair
# NEXT_PUBLIC_PRODUCT_HUNT_POST_ID=      # shows the Product Hunt badge above the homepage title
# NEXT_PUBLIC_PRODUCT_HUNT_SLUG=captionseasy
# GROQ_API_KEY=                          # server only, never NEXT_PUBLIC_ — enables the Creator Studio "Free AI" (Groq free tier, model openai/gpt-oss-120b) at /create. Unset = /create uses the template engine (+ optional on-device model) only.
# GROQ_MODEL=openai/gpt-oss-120b         # optional override, only if Groq rotates its free roster
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=  # Search Console HTML-tag token; when set, the root layout renders the google-site-verification meta tag (renders nothing while unset)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=         # Google Identity Services sign-in (public web OAuth client ID, NOT a secret): the pre-built "Sign in with Google" button on /login + the export SignupGate. The ID is read from the Supabase dashboard (Authentication → Providers → Google) — same OAuth client the Supabase Google provider uses. Unset = the old signInWithOAuth flow (Google's chooser then says "to continue to <project-ref>.supabase.co"). Register Authorized JavaScript origins https://captionit.in + https://www.captionit.in on that client in Google Cloud Console.
# ADSENSE_PUBLISHER_ID=                  # pub-XXXXXXXXXXXXXXXX; when set, /ads.txt serves the Google sellers line (404 while unset). No ads run today — readiness only.
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=      # pub-XXXXXXXXXXXXXXXX; Production env var — when set, the root layout renders the AdSense loader script (renders nothing while unset). Same id as ADSENSE_PUBLISHER_ID above.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=         # G-XXXXXXXXXX; when set, the root layout renders the GA4 gtag loader (renders nothing while unset). No id exists yet — create the GA4 property first, then set this.
# YOUTUBE_CLIENT_ID=                     # server only — Growth Studio "Connect YouTube" (Google Cloud OAuth client, YouTube Data API v3, scope youtube.readonly). Unset = the connect card shows "not switched on". Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/v1/growth/connect/youtube/callback
# YOUTUBE_CLIENT_SECRET=
# META_APP_ID=                           # server only — Growth Studio "Connect Instagram" (Meta app, Facebook Login + Instagram Graph API). Unset = the connect card shows "not switched on". Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/v1/growth/connect/instagram/callback. Insights metrics additionally need Meta App Review approval for instagram_manage_insights.
# META_APP_SECRET=

# Supabase (Open Caption project, second account) — set real values in Vercel env / .env.local
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
