h.dataset.intro="play";
var started=false;
function go(){if(started)return;started=true;requestAnimationFrame(function(){requestAnimationFrame(function(){
h.classList.add("ce-go");
setTimeout(function(){h.classList.add("ce-a-done")},2300);
setTimeout(function(){h.classList.add("ce-out")},6000);
})})}
function wait(){if(!document.querySelector(".ce-intro")){requestAnimationFrame(wait);return}
var f=document.fonts&&document.fonts.ready;if(f){Promise.race([f,new Promise(function(r){setTimeout(r,900)})]).then(go)}else go()}
wait();setTimeout(go,2500);
}catch(e){}})();</script><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="h-full bg-major text-obsidian font-sans selection:bg-emerald-accent selection:text-[#141412]"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="skip-link">Skip to main content</a><script type="application/ld+json">[{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Captionit","url":"https://www.captionit.in","description":"Drop in a short video and get animated captions timed to every word. Fix any word, pick a style, and export an MP4 or subtitle file — everything runs in your browser, your video file stays on your device, and it costs nothing.","applicationCategory":"MultimediaApplication","operatingSystem":"Web browser","browserRequirements":"Requires a modern browser with WebAssembly. WebGPU makes captioning faster.","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"},"featureList":["Automatic word-timed captions","150 animated caption looks","Motion Studio animated graphics (subscribe pills, follow cards, counters, titles)","English and Hindi / Hinglish speech recognition","MP4 export with burned-in captions","SRT subtitle export","No watermark","Video file stays on your device"],"image":"https://www.captionit.in/opengraph-image.jpg"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the automatic caption generator free?","acceptedAnswer":{"@type":"Answer","text":"Yes. Captions, every look, the full editor and MP4 and SRT exports are free, with no watermark. Free videos can be up to 5 minutes long. Paid 30-day passes raise the limits — see Pricing."}},{"@type":"Question","name":"Do I have to upload my video anywhere?","acceptedAnswer":{"@type":"Answer","text":"For transcription and the normal MP4 export, no. Speech recognition and rendering run inside your browser, so the video file is not sent anywhere for those. The file name, size, length and format are stored with your project, and your captions and transcripts are saved so you can reopen the project later. One exception: transparent overlay exports are rendered by the optional desktop Companion app, and that render does use the video from your project."}},{"@type":"Question","name":"Which languages can it caption?","acceptedAnswer":{"@type":"Answer","text":"14 languages: English, Hindi, Hinglish, Tamil, Telugu, Bengali, Marathi, Punjabi, Urdu, Spanish, French, German, Arabic and Portuguese. Hindi and Hinglish captions come out in Roman script, the way most creators type; Hindi in Devanagari script is a separate option."}},{"@type":"Question","name":"Can I fix a word it heard wrong?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every word is timed to the speech and every word is editable. Click a word, type the correction, and the timing stays. You can also shift all captions at once if the whole track is early or late."}},{"@type":"Question","name":"What can I export?","acceptedAnswer":{"@type":"Answer","text":"An MP4 with the captions burned in, ready to post on Reels, Shorts and TikTok; transparent overlay videos (MOV and WebM) rendered by the free desktop Companion app; and caption files (SRT, VTT, ASS, plain text and JSON) for YouTube, LinkedIn, Premiere, CapCut and other editors. MP4 export needs Chrome, Edge or Safari."}},{"@type":"Question","name":"What can it not do?","acceptedAnswer":{"@type":"Answer","text":"It transcribes what was actually said, so it cannot invent captions for silent video, and it will make mistakes on heavy background noise, overlapping speakers or very quiet speech. Fix those by editing the words. It is built for short video: free videos can be up to 5 minutes long, and the longest paid plan allows videos up to 3 hours."}}]}]</script><div class="min-h-screen bg-[#141412] text-[#FFFFEB]"><div data-nav="true" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4"><header class="mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-2xl border border-[#FFFFEB]/10 bg-[#1C1C1A] px-4 py-2.5 shadow-[0_8px_30px_-12px_rgba(0,0,0,0.25)]"><a aria-label="Captionit home" href="/"><span class="inline-flex shrink-0 select-none items-center gap-2 " role="img" aria-label="Captionit"><img src="/brand/opencaption-icon-light.svg" alt="" aria-hidden="true" height="28" class="block shrink-0 select-none" style="height:28px;width:auto" draggable="false"/><span class="font-styled font-black leading-none tracking-tight" style="font-size:22.959999999999997px">Caption<span class="font-serif font-normal italic">it</span></span></span></a><nav class="hidden items-center gap-6 whitespace-nowrap text-sm font-semibold text-[#FFFFEB]/80 lg:flex xl:gap-7"><a href="#how" class="py-1 hover:text-[#FFFFEB]">How it works</a><a href="#control" class="py-1 hover:text-[#FFFFEB]">Editor</a><a href="#looks" class="py-1 hover:text-[#FFFFEB]">Looks</a><a href="#privacy" class="py-1 hover:text-[#FFFFEB]">On your device</a><a href="#faq" class="py-1 hover:text-[#FFFFEB]">FAQ</a></nav><div class="flex items-center gap-2"><a class="hidden whitespace-nowrap rounded-xl px-3 py-2 text-sm font-semibold text-[#FFFFEB]/80 transition hover:text-[#FFFFEB] sm:block" href="/login">Sign in</a><a class="hidden items-center gap-1.5 whitespace-nowrap rounded-full bg-[#34D399] px-4 py-2 text-sm font-bold text-[#141412] sm:flex" href="/start?choose=1">Start free <span aria-hidden="true">→</span></a><button aria-label="Menu" aria-expanded="false" class="grid h-10 w-10 place-items-center rounded-xl border border-[#FFFFEB]/15 lg:hidden"><span class="relative block h-3 w-4"><span class="absolute left-0 top-0 h-[2px] w-4 bg-[#FFFFEB] transition "></span><span class="absolute bottom-0 left-0 h-[2px] w-4 bg-[#FFFFEB] transition "></span></span></button></div></header></div><main id="main-content" class="mx-auto max-w-3xl px-5 pb-24 pt-28 sm:pt-32"><p class="text-[12px] font-semibold uppercase tracking-[0.18em] text-[#34D399]">Automatic captions</p><h1 class="mt-3 font-serif text-4xl font-semibold leading-[1.08] tracking-[-0.015em] sm:text-5xl">Automatic video caption generator</h1><p class="mt-5 text-[16px] leading-relaxed text-[#FFFFEB]/80">Drop in a short video and get captions timed to every word, in minutes, free and in your browser. Pick one of 150 animated looks, fix any word it heard wrong, and export an MP4 ready to post or a subtitle file for YouTube. Nothing to install, no watermark, and for transcription and the normal MP4 export your video file is never uploaded anywhere.</p><div class="mt-8 flex flex-wrap gap-3"><a class="inline-flex items-center justify-center rounded-full bg-[#34D399] px-6 py-3 font-sora text-[14px] font-bold text-[#0B1512]" href="/start">Start free</a><a class="inline-flex items-center justify-center rounded-full border border-white/25 px-6 py-3 font-sora text-[14px] font-semibold text-[#FFFFEB]" href="/pricing">See pricing</a></div><section class="mt-16" aria-labelledby="how-it-works"><h2 id="how-it-works" class="font-sora text-[22px] font-bold">How it works</h2><ol class="mt-6 space-y-6"><li><h3 class="font-sora text-[16px] font-bold">1. Upload your video</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">Open <a class="underline decoration-[#34D399]/60 underline-offset-2" href="/start">Captionit</a> and drop in a clip. MP4, MOV, WebM and MKV work. The file stays on your device.</p></li><li><h3 class="font-sora text-[16px] font-bold">2. Transcribe in your browser</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">Whisper runs inside the tab and writes out what was said, timed to every word, in one of 14 languages including Hindi and Hinglish. If you only need the words, the standalone<!-- --> <a class="underline decoration-[#34D399]/60 underline-offset-2" href="/transcribe">Transcribe</a> <!-- -->tool does the same job and hands you a timed transcript.</p></li><li><h3 class="font-sora text-[16px] font-bold">3. Pick a look</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">Start from one of 150 animated caption looks, then change the font, colours, position and motion to match your video. Add a subscribe pill, a counter or a title from<!-- --> <a class="underline decoration-[#34D399]/60 underline-offset-2" href="/motion">Motion Studio</a> <!-- -->when the video needs one.</p></li><li><h3 class="font-sora text-[16px] font-bold">4. Fix any word</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">Click a word and type the correction. The timing stays. If the whole track is early or late, shift all captions at once instead of dragging them one by one.</p></li><li><h3 class="font-sora text-[16px] font-bold">5. Export and post</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">Export an MP4 with the captions burned in, ready for Reels, Shorts and TikTok, or a subtitle file (SRT, VTT, ASS, plain text or JSON) for YouTube and other editors.</p></li></ol></section><section class="mt-16" aria-labelledby="what-you-get"><h2 id="what-you-get" class="font-sora text-[22px] font-bold">What you get</h2><ul class="mt-6 space-y-3 text-[15px] leading-relaxed text-[#FFFFEB]/80"><li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]"></span><span>Word-timed captions. Every word lands on the frame where it is spoken, and the key word on each line gets its own colour, box or motion.</span></li><li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]"></span><span>150 animated looks, the largest style count we verified among rival tools in this research, and every look is in the free plan.</span></li><li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]"></span><span>14 languages, including Hindi and Hinglish. Hindi and Hinglish come out in Roman script, the way most creators type; Devanagari Hindi is a separate option.</span></li><li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]"></span><span>MP4 and subtitle export from one workflow. Most tools do one or the other; here you get both.</span></li><li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]"></span><span>No watermark, nothing to install. Transcription, editing and MP4 export all run in your browser, on desktop or phone.</span></li><li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]"></span><span>Built for vertical video. 9:16 Reels, Shorts and TikTok first, with 16:9 widescreen working the same way.</span></li></ul></section><section class="mt-16" aria-labelledby="languages"><h2 id="languages" class="font-sora text-[22px] font-bold">Captions in your language</h2><p class="mt-4 text-[15px] leading-relaxed text-[#FFFFEB]/70">English, Hindi, Hinglish, Tamil, Telugu, Bengali, Marathi, Punjabi, Urdu, Spanish, French, German, Arabic and Portuguese. Hinglish captions use a Whisper model fine-tuned for Hindi-English speech, so mixed Hindi-English talking comes out as the Roman-script Hinglish creators actually post, not as a translation.</p></section><section class="mt-16" aria-labelledby="formats"><h2 id="formats" class="font-sora text-[22px] font-bold">Export formats</h2><p class="mt-4 text-[15px] leading-relaxed text-[#FFFFEB]/70">MP4 with captions burned in; transparent overlays as MOV (ProRes) or WebM, rendered by the free desktop Companion app; and caption files as SRT, VTT, ASS, plain text or JSON. Translated tracks add translated SRT and VTT rows. MP4 export needs Chrome, Edge or Safari.</p></section><section class="mt-16" aria-labelledby="limits"><h2 id="limits" class="font-sora text-[22px] font-bold">What it cannot do</h2><p class="mt-4 text-[15px] leading-relaxed text-[#FFFFEB]/70">It transcribes what was actually said, so it cannot write captions for silent video, and it will make mistakes on heavy background noise, overlapping speakers or very quiet speech. Those are fixed by editing the words, not by re-running. It is built for short video: free videos can be up to 5 minutes long, and paid plans allow longer videos up to 3 hours. Transparent overlay exports need the Companion app; the normal MP4 export does not.</p></section><section class="mt-16" aria-labelledby="pricing-note"><h2 id="pricing-note" class="font-sora text-[22px] font-bold">Free, with paid passes when you outgrow it</h2><p class="mt-4 text-[15px] leading-relaxed text-[#FFFFEB]/70">The free plan includes the full editor, all 150 looks and every AI tool. Paid plans are 30-day passes that raise the limits: more projects, longer videos, bigger uploads, longer export storage. You pay once; nothing renews or charges you again automatically. See<!-- --> <a class="underline decoration-[#34D399]/60 underline-offset-2" href="/pricing">Pricing</a> <!-- -->for the plans in your currency.</p></section><section class="mt-16" aria-labelledby="faq"><h2 id="faq" class="font-sora text-[22px] font-bold">Frequently asked questions</h2><div class="mt-6 space-y-8"><div><h3 class="font-sora text-[16px] font-bold">Is the automatic caption generator free?</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">Yes. Captions, every look, the full editor and MP4 and SRT exports are free, with no watermark. Free videos can be up to 5 minutes long. Paid 30-day passes raise the limits — see Pricing.</p></div><div><h3 class="font-sora text-[16px] font-bold">Do I have to upload my video anywhere?</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">For transcription and the normal MP4 export, no. Speech recognition and rendering run inside your browser, so the video file is not sent anywhere for those. The file name, size, length and format are stored with your project, and your captions and transcripts are saved so you can reopen the project later. One exception: transparent overlay exports are rendered by the optional desktop Companion app, and that render does use the video from your project.</p></div><div><h3 class="font-sora text-[16px] font-bold">Which languages can it caption?</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">14 languages: English, Hindi, Hinglish, Tamil, Telugu, Bengali, Marathi, Punjabi, Urdu, Spanish, French, German, Arabic and Portuguese. Hindi and Hinglish captions come out in Roman script, the way most creators type; Hindi in Devanagari script is a separate option.</p></div><div><h3 class="font-sora text-[16px] font-bold">Can I fix a word it heard wrong?</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">Yes. Every word is timed to the speech and every word is editable. Click a word, type the correction, and the timing stays. You can also shift all captions at once if the whole track is early or late.</p></div><div><h3 class="font-sora text-[16px] font-bold">What can I export?</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">An MP4 with the captions burned in, ready to post on Reels, Shorts and TikTok; transparent overlay videos (MOV and WebM) rendered by the free desktop Companion app; and caption files (SRT, VTT, ASS, plain text and JSON) for YouTube, LinkedIn, Premiere, CapCut and other editors. MP4 export needs Chrome, Edge or Safari.</p></div><div><h3 class="font-sora text-[16px] font-bold">What can it not do?</h3><p class="mt-1 text-[15px] leading-relaxed text-[#FFFFEB]/70">It transcribes what was actually said, so it cannot invent captions for silent video, and it will make mistakes on heavy background noise, overlapping speakers or very quiet speech. Fix those by editing the words. It is built for short video: free videos can be up to 5 minutes long, and the longest paid plan allows videos up to 3 hours.</p></div></div></section><section class="mt-16 rounded-2xl border border-white/10 bg-[#1C1C1A] p-6 sm:p-8" aria-labelledby="closing"><h2 id="closing" class="font-serif text-2xl font-semibold">Caption your next video free</h2><p class="mt-3 text-[15px] leading-relaxed text-[#FFFFEB]/70">Captionit is made by one person, for creators who post every day. Read more on the<!-- --> <a class="underline decoration-[#34D399]/60 underline-offset-2" href="/about">About</a> page, or go straight to the<!-- --> <a class="underline decoration-[#34D399]/60 underline-offset-2" href="/">homepage</a> to see the full studio.</p><a class="mt-6 inline-flex items-center justify-center rounded-full bg-[#34D399] px-6 py-3 font-sora text-[14px] font-bold text-[#0B1512]" href="/start">Caption a video free</a></section></main><footer class="relative overflow-hidden border-t border-[#FFFFEB]/10 bg-[#1E1E1B] pt-20 pb-10 text-[#FFFFEB]"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 lg:gap-16 pb-16"><div class="space-y-4"><h3 class="font-mono text-xs font-bold uppercase tracking-widest text-[#FFFFEB]/50">Product</h3><ul class="space-y-0.5 text-sm text-[#FFFFEB]/75 lg:space-y-2.5"><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#how">How it works</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/pricing">Pricing</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/auto-caption-generator">Auto caption generator</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/transcribe">Transcribe</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#looks">Looks gallery</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#control">Precision controls</a></li></ul></div><div class="space-y-4"><h3 class="font-mono text-xs font-bold uppercase tracking-widest text-[#FFFFEB]/50">For creators</h3><ul class="space-y-0.5 text-sm text-[#FFFFEB]/75 lg:space-y-2.5"><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#looks">Looks for Shorts, Reels &amp; TikTok</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#faq">Hindi &amp; Hinglish support</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#faq">Export formats, incl. overlays</a></li></ul></div><div class="space-y-4"><h3 class="font-mono text-xs font-bold uppercase tracking-widest text-[#FFFFEB]/50">Help</h3><ul class="space-y-0.5 text-sm text-[#FFFFEB]/75 lg:space-y-2.5"><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#faq">Frequently asked questions</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/dashboard">Project studio</a></li></ul></div><div class="space-y-4"><h3 class="font-mono text-xs font-bold uppercase tracking-widest text-[#FFFFEB]/50">Company</h3><ul class="space-y-0.5 text-sm text-[#FFFFEB]/75 lg:space-y-2.5"><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/about">About</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="mailto:work.techhacksai@gmail.com">Support</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/login">Sign in to app</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/terms">Terms of service</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/privacy">Privacy policy</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/cookies">Cookie policy</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/acceptable-use">Acceptable use</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/copyright">Copyright &amp; takedowns</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/subprocessors">Subprocessors</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/credits">Credits &amp; licences</a></li></ul></div></div><div class="pt-10 sm:pt-14 border-t border-[#FFFFEB]/10 flex items-center justify-between overflow-hidden select-none"><a class="group flex items-center gap-3 sm:gap-5 w-full" href="/"><svg viewBox="0 0 100 100" class="h-12 w-auto shrink-0 sm:h-20 md:h-28 lg:h-36" aria-hidden="true" role="presentation"><rect x="16" y="32" width="46" height="13" rx="6.5" fill="#FFFFEB"></rect><rect x="16" y="55" width="60" height="13" rx="6.5" fill="#FFFFEB"></rect><rect x="80" y="55" width="13" height="13" rx="2.5" fill="#FFA946"></rect></svg><span class=