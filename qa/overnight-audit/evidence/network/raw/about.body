i-track editor and creator tools that run on your own device. Run by Parvez Achhan Ali Siddiqui, a sole proprietor in India."/><meta name="twitter:image" content="https://www.captionit.in/twitter-image.jpg"/><link rel="icon" href="/favicon.ico?favicon.0ckg_w09q489x.ico" sizes="32x32" type="image/x-icon"/><link rel="icon" href="/icon.svg?icon.3b_ak8uwg1toh.svg" sizes="any" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-icon.png?apple-icon.1zg5civk715du.png" sizes="180x180" type="image/png"/><script>(function(){try{
var hsh=location.hash||"",q=location.search||"";
var isReturn=/(^|[#&])(access_token|error_description)=/.test(hsh)||/[?&]code=[^&]{20,}/.test(q);
if(!isReturn||location.pathname==="/reset-password")return;
// password-reset links carry a session too: they belong on /reset-password, never the studio
if(/[#&]type=recovery/.test(hsh)){location.replace("/reset-password"+hsh);return}
var canon="https://www.captionit.in";
var host=location.hostname;
var wrongHost=/.vercel.app$/.test(host)&&canon.indexOf("//"+host)<0&&/[#&]access_token=/.test(hsh);
