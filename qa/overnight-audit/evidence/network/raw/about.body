if(location.pathname!=="/start"){location.replace("/start"+q+hsh)}
}catch(e){}})();</script><script>(function(){try{
var h=document.documentElement;if(location.pathname!=="/")return;
var k="ce_intro",force=false||/[?&]intro\b/.test(location.search);
if(!force&&(sessionStorage.getItem(k)||matchMedia("(pointer:coarse)").matches)){h.dataset.intro="skip";return}
try{sessionStorage.setItem(k,"1")}catch(e){}
h.dataset.intro="play";
var started=false;
function go(){if(started)return;started=true;requestAnimationFrame(function(){requestAnimationFrame(function(){
h.classList.add("ce-go");
setTimeout(function(){h.classList.add("ce-a-done")},2300);
setTimeout(function(){h.classList.add("ce-out")},6000);
})})}
function wait(){if(!document.querySelector(".ce-intro")){requestAnimationFrame(wait);return}
var f=document.fonts&&document.fonts.ready;if(f){Promise.race([f,new Promise(function(r){setTimeout(r,900)})]).then(go)}else go()}
wait();setTimeout(go,2500);
}catch(e){}})();</script><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="h-full bg-major text-obsidian font-sans selection:bg-emerald-accent selection:text-[#141412]"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="skip-link">Skip to main content</a><div class="min-h-screen bg-major text-obsidian"><header class="sticky top-0 z-30 border-b border-obsidian/10 bg-major"><div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4"><a aria-label="Captionit home" href="/"><span class="inline-flex shrink-0 select-none items-center gap-2 " role="img" aria-label="Captionit"><img src="/brand/opencaption-icon-light.svg" alt="" aria-hidden="true" height="26" class="block shrink-0 select-none" style="height:26px;width:auto" draggable="false"/><span class="font-styled font-black leading-none tracking-tight" style="font-size:21.32px">Caption<span class="font-serif font-normal italic">it</span></span></span></a><a class="rounded-full bg-obsidian px-4 py-2 text-sm font-semibold text-major transition hover:bg-obsidian/85" href="/start">Start free</a></div></header><div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:py-16"><nav aria-label="Legal documents" class="min-w-0 lg:sticky lg:top-24 lg:self-start"><p class="mb-3 hidden text-xs font-semibold uppercase tracking-wider text-obsidian/50 lg:block">Legal</p><ul class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] lg:mx-0 lg:flex-col lg:gap-1 lg:overflow-visible lg:px-0"><li class="shrink-0"><a aria-current="page" class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian bg-obsidian text-major lg:bg-emerald-accent lg:text-[#141412]" href="/about">About</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/terms">Terms of Service</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/privacy">Privacy Policy</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/cookies">Cookie Policy</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/acceptable-use">Acceptable Use</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/copyright">Copyright &amp; Takedowns</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/subprocessors">Subprocessors</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/credits">Credits &amp; Licences</a></li></ul></nav><main id="main-content" class="min-w-0"><article class="max-w-3xl"><p class="text-xs font-semibold uppercase tracking-wider text-obsidian/50">Effective <!-- -->30 September 2026</p><h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">About<!-- --> <em class="text-obsidian/70">Captionit</em></h1><div class="mt-5 text-lg leading-relaxed text-obsidian/75">Captionit<!-- --> is a caption and video studio that runs in your browser: it transcribes your videos on your own device, styles the words with animated caption templates, and gives you a full multi-track editor and a set of creator tools around it — no uploads to a rendering farm, no software to install.</div><div class="mt-10 space-y-10"><section id="what" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#what" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">What you can do here</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><ul><li><strong>Captions:</strong> speech recognition runs in your browser (English, Roman Hinglish and Devanagari Hindi), timed word by word, with 150 animated templates and a word-level editor.</li><li><strong>Editing:</strong> a multi-track timeline with trims, splits, text and media overlays, effects, transitions, speed changes and an audio studio — and what you preview is what the export renders.</li><li><strong>Clipper:</strong> find the moments worth posting from a longer video — suggestions measured on the device from silence and scene changes, plus an AI Clipping Studio that ranks moments from the transcript with an editorial estimate — then reframe them for vertical formats.</li><li><strong>Creator Studio:</strong> hook ideas, scripts, captions and hashtags, a reel analyzer, a content planner, a teleprompter and growth tracking — the AI writing tools run on a free model and say so when they fall back to templates.</li><li><strong>Exports:</strong> MP4 video plus SRT, VTT, ASS, plain-text and JSON caption files, and transparent overlays for other editors (rendered by the free desktop Companion app).</li></ul></div></section><section id="how" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#how" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">How it works</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>The heavy work — transcription, editing previews and MP4 rendering — happens on your device, in the browser. Your video files live in your browser’s storage on this device; an account only syncs your projects, captions, full transcripts and settings — plus the file name, size, length and format of each video — so you can pick them up elsewhere. That design is also the privacy story: your audio is never sent to a third-party speech service. The<!-- --> <a href="/privacy">Privacy Policy</a> describes exactly what is stored where.</p></div></section><section id="who" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#who" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">Who runs it</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Captionit<!-- --> is built and run by <!-- -->Parvez Achhan Ali Siddiqui, an individual (sole proprietor) trading as Captionit<!-- -->, based in <!-- -->India<!-- -->. It is a one-person operation: the same person designs the templates, writes the code, answers support email and handles payments and refunds. Support is at <strong>work.techhacksai@gmail.com</strong> — you will get a person, not a ticket queue.</p></div></section><section id="money" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#money" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">How it&#x27;s paid for</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>The full editor is free. Paid plans are 30-day passes that raise limits — more projects, bigger uploads, longer videos, longer export retention — at the prices on the <a href="/pricing">Pricing page</a>; they never renew automatically. The site may also show advertising in the future; if it does, the<!-- --> <a href="/privacy">Privacy Policy</a> and <a href="/cookies">Cookie Policy</a> describe how that works and how to opt out of personalised ads.</p></div></section></div><p class="mt-14 rounded-2xl border border-obsidian/10 bg-muted-beige/40 p-5 text-sm leading-relaxed text-obsidian/70">Questions about this document? Write to <strong class="text-obsidian">work.techhacksai@gmail.com</strong>. <!-- -->Parvez Achhan Ali Siddiqui, an individual (sole proprietor) trading as Captionit<!-- -->, <!-- -->India<!-- -->.</p></article><!--$--><!--/$--></main></div><footer class="relative overflow-hidden border-t border-[#FFFFEB]/10 bg-[#1E1E1B] pt-20 pb-10 text-[#FFFFEB]"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 lg:gap-16 pb-16"><div class="space-y-4"><h3 class="font-mono text-xs font-bold uppercase tracking-widest text-[#FFFFEB]/50">Product</h3><ul class="space-y-0.5 text-sm text-[#