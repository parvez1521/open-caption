oh.svg" sizes="any" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-icon.png?apple-icon.1zg5civk715du.png" sizes="180x180" type="image/png"/><script>(function(){try{
var hsh=location.hash||"",q=location.search||"";
