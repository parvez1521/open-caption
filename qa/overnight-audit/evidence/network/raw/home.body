in your browser."/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Word-timed captions for Reels, Shorts and TikTok, made in your browser | Captionit"/><meta name="twitter:description" content="Drop in a short video and get animated captions timed to every word. Fix any word, pick a style, and export an MP4 or subtitle file — everything runs in your browser, your video file stays on your device, and it costs nothing."/><meta name="twitter:image" content="https://www.captionit.in/twitter-image.jpg"/><link rel="icon" href="/favicon.ico?favicon.0ckg_w09q489x.ico" sizes="32x32" type="image/x-icon"/><link rel="icon" href="/icon.svg?icon.3b_ak8uwg1toh.svg" sizes="any" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-icon.png?apple-icon.1zg5civk715du.png" sizes="180x180" type="image/png"/><script>(function(){try{
var hsh=location.hash||"",q=location.search||"";
var isReturn=/(^|[#&])(access_token|error_description)=/.test(hsh)||/[?&]code=[^&]{20,}/.test(q);
if(!isReturn||location.pathname==="/reset-password")return;
// password-reset links carry a session too: they belong on /reset-password, never the studio
if(/[#&]type=recovery/.test(hsh)){location.replace("/reset-password"+hsh);return}
var canon="https://www.captionit.in";
var host=location.hostname;
var wrongHost=/.vercel.app$/.test(host)&&canon.indexOf("//"+host)<0&&/[#&]access_token=/.test(hsh);
if(wrongHost){location.replace(canon+"/start"+hsh);return}
if(location.pathname!=="/start"){location.replace("/start"+q+hsh)}
}catch(e){}})();</script><script>(function(){try{
var h=document.documentElement;if(location.pathname!=="/")return;
var k="ce_intro",force=false||/[?&]intro\b/.test(location.search);
if(!force&&(sessionStorage.getItem(k)||matchMedia("(pointer:coarse)").matches)){h.dataset.intro="skip";return}
try{sessionStorage.setItem(k,"1")}catch(e){}
h.dataset.intro="play";
var started=false;
function go(){if(started)return;started=true;requestAnimationFrame(function(){requestAnimationFrame(function(){
h.classList.add("ce-go");
setTimeout(function(){h.classList.add("ce-a-done")},2300);
setTimeout(function(){h.classList.add("ce-out")},6000);
})})}
function wait(){if(!document.querySelector(".ce-intro")){requestAnimationFrame(wait);return}
var f=document.fonts&&document.fonts.ready;if(f){Promise.race([f,new Promise(function(r){setTimeout(r,900)})]).then(go)}else go()}
wait();setTimeout(go,2500);
}catch(e){}})();</script><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="h-full bg-major text-obsidian font-sans selection:bg-emerald-accent selection:text-[#141412]"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="skip-link">Skip to main content</a><script type="application/ld+json">[{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Captionit","url":"https://www.captionit.in","description":"Drop in a short video and get animated captions timed to every word. Fix any word, pick a style, and export an MP4 or subtitle file — everything runs in your browser, your video file stays on your device, and it costs nothing.","applicationCategory":"MultimediaApplication","operatingSystem":"Web browser","browserRequirements":"Requires a modern browser with WebAssembly. WebGPU makes captioning faster.","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"},"featureList":["Automatic word-timed captions","150 animated caption looks","Motion Studio animated graphics (subscribe pills, follow cards, counters, titles)","English and Hindi / Hinglish speech recognition","MP4 export with burned-in captions","SRT subtitle export","No watermark","Video file stays on your device"],"image":"https://www.captionit.in/opengraph-image.jpg"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Captionit really free?","acceptedAnswer":{"@type":"Answer","text":"Yes. Captions, every look, the full editor and MP4 and SRT exports are free, with no watermark. Free videos can be up to 5 minutes long. Paid 30-day passes raise the limits — see Pricing."}},{"@type":"Question","name":"Is my video uploaded anywhere?","acceptedAnswer":{"@type":"Answer","text":"For transcription and the normal MP4 export, no — speech recognition and rendering run inside your browser, so the video file is not sent anywhere for those. The file name, size, length and format of each video are stored with your project, and your captions and full transcripts are saved so you can reopen the project later. One exception: transparent overlay exports are rendered by the optional desktop Companion app, and that render does use the video from your project."}},{"@type":"Question","name":"Will Captionit work with vertical 9:16 Shorts, Reels, and TikToks?","acceptedAnswer":{"@type":"Answer","text":"Yes. Vertical 9:16 is what Captionit is built for, and 16:9 widescreen works the same way. You can drag the caption box anywhere in the frame, clear of faces and platform buttons."}},{"@type":"Question","name":"How is Captionit different from basic CapCut or Premiere captions?","acceptedAnswer":{"@type":"Answer","text":"CapCut and Premiere captions are plain timed text. Here every word is timed to the speech, the key word on each line gets its own colour, box or motion, and you start from 150 animated looks. No watermark, nothing to install."}},{"@type":"Question","name":"Do I need to install anything?","acceptedAnswer":{"@type":"Answer","text":"No. Transcription, editing and MP4 export all run in your browser, on desktop or phone."}},{"@type":"Question","name":"Can I customize the font, colors, and animations?","acceptedAnswer":{"@type":"Answer","text":"Yes. Start from a look, such as the Hormozi-style box, Karaoke Fill, Beast Bounce, Luxe Serif, Neon, Comic or Retro 3D, then change fonts, colours, outlines, position and motion. Save your colours and font as a brand kit and reuse it on every project."}},{"@type":"Question","name":"Does it support Hindi and Hinglish?","acceptedAnswer":{"@type":"Answer","text":"Yes, in 14 languages. Hindi / Hinglish captions come out in Roman script, the way most creators type, from a Whisper model fine-tuned for Hindi-English speech. Hindi (देवनागरी) comes out in Devanagari script. The rest, Tamil, Telugu, Bengali, Marathi, Punjabi, Urdu, Spanish, French, German, Arabic and Portuguese, use the multilingual Whisper model."}},{"@type":"Question","name":"What export formats are supported?","acceptedAnswer":{"@type":"Answer","text":"An MP4 with the captions burned in, ready to post on Reels, Shorts and TikTok; transparent overlay videos (MOV and WebM) rendered by the free desktop Companion app; and caption files (SRT, VTT, ASS, plain text and JSON) for YouTube, LinkedIn, Premiere, CapCut and other editors."}}]}]</script><main id="main-content" class="relative min-h-screen overflow-x-clip bg-[#141412] font-sans text-[#FFFFEB]"><div class="ce-intro pointer-events-none fixed inset-0 z-[100]" aria-hidden="true"><style>
html[data-intro="skip"] .ce-intro{display:none}
@media (prefers-reduced-motion: reduce){.ce-intro{display:none}}
html:not(.ce-go) .ce-intro *{animation-play-state:paused!important}
.ce-intro [data-mark]{animation:ce-mark-in .7s cubic-bezier(0.16, 1, 0.3, 1) both}
@keyframes ce-mark-in{from{opacity:0;transform:translateY(10px) scale(.94)}to{opacity:1;transform:none}}
.ce-intro [data-card]{animation:ce-card-in .7s cubic-bezier(0.16, 1, 0.3, 1) 120ms both}
@keyframes ce-card-in{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.ce-intro [data-w]{animation:ce-pop .45s cubic-bezier(0.34, 1.56, 0.64, 1) both}
@keyframes ce-pop{from{opacity:0;transform:translateY(14px) scale(.92)}to{opacity:1;transform:none}}
.ce-intro [data-wt]{animation:ce-dim .25s ease-out both}
@keyframes ce-dim{from{opacity:1}to{opacity:.45}}
.ce-intro [data-hl]{transform-origin:0 50%;animation:ce-hl-in .32s cubic-bezier(0.215, 0.61, 0.355, 1) both,ce-hl-out .2s ease-out forwards}
.ce-intro [data-hl].last{animation:ce-hl-in .32s cubic-bezier(0.215, 0.61, 0.355, 1) both}
@keyframes ce-hl-in{from{opacity:0;transform:scaleX(.2)}to{opacity:1;transform:none}}
@keyframes ce-hl-out{to{opacity:0}}
.ce-intro [data-capline]{animation:ce-capline 2300ms cubic-bezier(.45,0,.55,1) 50ms both}
@keyframes ce-capline{from{width:0}to{width:240px}}
html.ce-out .ce-intro [data-inner]{animation:ce-out .45s cubic-bezier(0.55, 0.055, 0.675, 0.19) both}
html.ce-out .ce-intro [data-foot]{animation:ce-fade .3s ease-in both}
html.ce-out .ce-intro [data-sheet]{animation:ce-sheet 950ms cubic-bezier(0.87, 0, 0.13, 1) 180ms both}
@keyframes ce-out{to{opacity:0;transform:translateY(-36px)}}
@keyframes ce-fade{to{opacity:0}}
@keyframes ce-sheet{to{transform:translateY(calc(-100% - 16vh))}}
</style><div data-sheet="true" class="pointer-events-auto absolute inset-0 bg-[#1E1E1B]"><div class="absolute left-[-10%] top-full h-[16vh] w-[120%] rounded-b-[50%] bg-[#1E1E1B]"></div><div class="absolute inset-0 overflow-hidden"><div class="absolute -left-32 top-10 h-[420px] w-[420px] rounded-full bg-[#252B26]/70 blur-3xl"></div><div class="absolute -right-24 bottom-10 h-[380px] w-[380px] rounded-full bg-[#FFA946]/25 blur-3xl"></div><div data-inner="true" class="relative grid h-full place-items-center px-6"><div class="flex flex-col items-center"><div data-mark="true"><span class="inline-flex shrink-0 select-none items-center gap-2 " role="img" aria-label="Captionit"><img src="/brand/opencaption-icon-light.svg" alt="" aria-hidden="true" height="36" class="block shrink-0 select-none" style="height:36px;width:auto" draggable="false"/></span></div><div data-card="true" class="mt-6 rounded-2xl border border-[#FFFFEB]/10 bg-[#141412] px-6 py-5 sm:px-8"><div class="flex flex-wrap items-center justify-center gap-x-[14px] gap-y-2 text-[18px] font-extrabold uppercase tracking-[-0.01em] text-[#FFFFEB] sm:text-[22px]"><span data-w="true" class="relative inline-block" style="animation-delay:600ms"><span data-hl="true" class="absolute -inset-x-[6px] -inset-y-[4px] rounded-[10px] bg-[#252B26]" style="animation-delay:600ms, 830ms"></span><span data-wt="" class="relative " style="animation-delay:830ms">Every</span></span><span data-w="true" class="relative inline-block" style="animation-delay:830ms"><span data-hl="true" class="absolute -inset-x-[6px] -inset-y-[4px] rounded-[10px] bg-[#252B26]" style="animation-delay:830ms, 1060ms"></span><span data-wt="" class="relative " style="animation-delay:1060ms">word,</span></span><span data-w="true" class="relative inline-block" style="animation-delay:1060ms"><span data-hl="true" class="absolute -inset-x-[6px] -inset-y-[4px] rounded-[10px] bg-[#252B26]" style="animation-delay:1060ms, 1290ms"></span><span data-wt="" class="relative " style