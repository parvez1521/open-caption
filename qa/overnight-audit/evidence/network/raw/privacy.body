"/apple-icon.png?apple-icon.1zg5civk715du.png" sizes="180x180" type="image/png"/><script>(function(){try{
var hsh=location.hash||"",q=location.search||"";
var isReturn=/(^|[#&])(access_token|error_description)=/.test(hsh)||/[?&]code=[^&]{20,}/.test(q);
if(!isReturn||location.pathname==="/reset-password")return;
// password-reset links carry a session too: they belong on /reset-password, never the studio
if(/[#&]type=recovery/.test(hsh)){location.replace("/reset-password"+hsh);return}
var canon="https://www.captionit.in";
var host=location.hostname;
var wrongHost=/.vercel.app$/.test(host)&&canon.indexOf("//"+host)<0&&/[#&]access_token=/.test(hsh);
if(wrongHost){location.replace(canon+"/start"+hsh);return}
if(location.pathname!=="/start"){location.replace("/start"+q+hsh)}
}catch(e){}})();</script><script>(function(){try{
var h=document.documentElement;if(location.pathname!=="/")return;
var k="ce_intro",force=false||/[?&]intro\b/.test(location.search);
if(!force&&(sessionStorage.getItem(k)||matchMedia("(pointer:coarse)").matches)){h.dataset.intro="skip";return}
try{sessionStorage.setItem(k,"1")}catch(e){}
h.dataset.intro="play";
var started=false;
function go(){if(started)return;started=true;requestAnimationFrame(function(){requestAnimationFrame(function(){
h.classList.add("ce-go");
setTimeout(function(){h.classList.add("ce-a-done")},2300);
setTimeout(function(){h.classList.add("ce-out")},6000);
})})}
function wait(){if(!document.querySelector(".ce-intro")){requestAnimationFrame(wait);return}
var f=document.fonts&&document.fonts.ready;if(f){Promise.race([f,new Promise(function(r){setTimeout(r,900)})]).then(go)}else go()}
wait();setTimeout(go,2500);
}catch(e){}})();</script><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="h-full bg-major text-obsidian font-sans selection:bg-emerald-accent selection:text-[#141412]"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="skip-link">Skip to main content</a><div class="min-h-screen bg-major text-obsidian"><header class="sticky top-0 z-30 border-b border-obsidian/10 bg-major"><div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4"><a aria-label="Captionit home" href="/"><span class="inline-flex shrink-0 select-none items-center gap-2 " role="img" aria-label="Captionit"><img src="/brand/opencaption-icon-light.svg" alt="" aria-hidden="true" height="26" class="block shrink-0 select-none" style="height:26px;width:auto" draggable="false"/><span class="font-styled font-black leading-none tracking-tight" style="font-size:21.32px">Caption<span class="font-serif font-normal italic">it</span></span></span></a><a class="rounded-full bg-obsidian px-4 py-2 text-sm font-semibold text-major transition hover:bg-obsidian/85" href="/start">Start free</a></div></header><div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:py-16"><nav aria-label="Legal documents" class="min-w-0 lg:sticky lg:top-24 lg:self-start"><p class="mb-3 hidden text-xs font-semibold uppercase tracking-wider text-obsidian/50 lg:block">Legal</p><ul class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] lg:mx-0 lg:flex-col lg:gap-1 lg:overflow-visible lg:px-0"><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/about">About</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/terms">Terms of Service</a></li><li class="shrink-0"><a aria-current="page" class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian bg-obsidian text-major lg:bg-emerald-accent lg:text-[#141412]" href="/privacy">Privacy Policy</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/cookies">Cookie Policy</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/acceptable-use">Acceptable Use</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/copyright">Copyright &amp; Takedowns</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/subprocessors">Subprocessors</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/credits">Credits &amp; Licences</a></li></ul></nav><main id="main-content" class="min-w-0"><article class="max-w-3xl"><p class="text-xs font-semibold uppercase tracking-wider text-obsidian/50">Effective <!-- -->30 September 2026</p><h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Privacy<!-- --> <em class="text-obsidian/70">Policy</em></h1><div class="mt-5 text-lg leading-relaxed text-obsidian/75">This policy explains what we collect when you use the website, the studio and the optional desktop Companion app, why, who processes it for us, how long we keep it, and the choices you have. <!-- -->Parvez Achhan Ali Siddiqui, an individual (sole proprietor) trading as Captionit<!-- --> is the controller of this data.</div><div class="mt-10 space-y-10"><section id="summary" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#summary" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">In short</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><ul><li>Speech recognition runs <strong>in your browser</strong>, on your own device. We do not send your audio to a third-party speech service.</li><li>We store your account, your projects (captions, full word-level transcripts and settings) and your exports so the studio works across devices. Your video files stay on your device — only their file name, size, length and format are stored with your project. The one exception is a transparent-overlay export you send to the desktop Companion app: that video passes through our storage so the Companion can render it.</li><li>We do not sell personal data, and do not train AI models on your videos or transcripts.</li><li>If advertising is enabled on the site, Google and other third-party vendors may use cookies to serve ads based on your prior visits — section 8 explains this and how to opt out. No ads run inside the editor, and advertising never touches your videos or transcripts.</li></ul></div></section><section id="collect" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#collect" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">1. What we collect</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><ul><li><strong>Account data:</strong> email address, name, password (stored only as a secure hash by our authentication provider) or your Google sign-in identity, and profile picture if your sign-in provider supplies one.</li><li><strong>Your content:</strong> the videos you add (the files stay on your device; only their file name, size, length and format are stored with your project — except a video you send to a Companion export, which passes through our storage for that job), transcripts, captions, styles, saved looks, brand colours and fonts, and the files you export.</li><li><strong>Companion data:</strong> for each computer you pair: its name, operating system, app version and capabilities (such as available disk space and installed speech models), and when it was last online. Pairing tokens are stored only as a secure hash.</li><li><strong>Usage data:</strong> how much you upload, transcribe and render (to apply plan limits), job status and error logs, and basic request logs (IP address, browser, time) kept by our hosting provider for security and debugging.</li><li><strong>Messages:</strong> anything you send us by email.</li></ul></div></section><section id="use" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#use" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">2. Why we use it</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><ul><li>To provide the service: store and show your projects, transcribe and render when you ask, keep your edits in sync (performance of our contract with you).</li><li>To keep it secure and working: detect abuse, prevent fraud, rate-limit, debug (legitimate interests).</li><li>To apply usage limits (contract).</li><li>To contact you about your account and important changes (contract; legitimate interests). Product newsletters only with your consent, with an unsubscribe link in every one.</li></ul></div></section><section id="local" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#local" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">3. On-device processing</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>By default, everything runs in your browser: speech recognition, editing and MP4 rendering happen on your device, and your video file is never uploaded. Only the file’s name, size, length and format are sent to our servers and stored with your project. The optional desktop Companion app is the exception. For a transparent overlay export, the Companion downloads your video from our storage to your computer, renders the export locally, and uploads the result back to your account. The rendering never sends your video or audio anywhere else. The Companion keeps a local cache of videos it has processed, which you can clear by deleting its cache folder.</p></div></section><section id="ai" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#ai" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">AI features</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Some features send text you choose to our AI provider, Groq (see the <a href="/subprocessors">Subprocessors page</a>). Growth Coach sends the question you ask, the last few turns of that chat, and a summary of your own Growth Studio data — your post titles and their views, reach, likes, comments, shares and saves, and the names, handles and notes of competitors you track. The Create tools send the prompt text you write, and Clipper highlights send transcript text from your video. No audio or video is ever sent to Groq, and we do not train AI models on anything you send.</p></div></section><section id="cloud" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#cloud" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">4. Transcription</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Speech recognition runs in your browser with a speech model downloaded once to your device. The audio of your video is processed there and is not sent to a third-party speech service.</p></div></section><section id="sharing" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#sharing" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">5. Who processes data for us</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>We use a small number of service providers (subprocessors) to host the service, store files, sign you in, report errors, run our AI features and deliver speech models to your browser. The current list, with what each one does and where, is on our <a href="/subprocessors">Subprocessors page</a>. We share data with authorities only when legally required, and we would tell you unless we are prohibited from doing so.</p></div></section><section id="transfers" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#transfers" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">6. International transfers</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Our providers may store or process data outside your country, including in India (database and file storage) and the United States (website hosting and AI processing). Where the law requires it, we rely on appropriate safeguards such as standard contractual clauses.</p></div></section><section id="retention" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#retention" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">7. How long we keep it</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><ul><li>Projects and captions: until you delete them or close your account.</li><li>Exports: kept for 7 to 60 days depending on your plan (see Pricing), then deleted automatically.</li><li>Deleted projects: removed from storage within 30 days, including backups.</li><li>Account data: until you close your account, then deleted within 30 days, except records we must keep by law (for example invoices).</li><li>Security and request logs: typically up to 30 days.</li></ul></div></section><section id="advertising" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#advertising" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">8. Advertising</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>We may show advertising on this website, served by Google AdSense. This section applies whenever advertising is enabled; while it is not enabled, no advertising cookies are set and no ad requests are made.</p><ul><li>Third-party vendors, including Google, use cookies to serve ads based on your prior visits to this and other websites.</li><li>Google’s use of advertising cookies enables it and its partners to serve ads based on your visits to this site and/or other sites on the Internet.</li><li>You can opt out of personalised advertising by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noreferrer">Google Ads Settings</a>, or opt out of many third-party vendors’ cookies at <a href="https://www.aboutads.info/choices/" target="_blank" rel="noreferrer">aboutads.info</a>. Opting out does not remove ads; it makes them non-personalised.</li><li>Where the law requires it (for example in the EEA and the UK), personalised ads are only served after a consent choice through a Google-certified consent management platform.</li><li>Advertising is separate from the product: it never uses your videos, audio, transcripts or projects, and ads are not shown inside the editor or your account pages.</li></ul></div></section><section id="rights" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#rights" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">9. Your rights and choices</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Depending on where you live (including under India’s Digital Personal Data Protection Act, the GDPR and US state privacy laws) you can ask to access, correct, download or delete your personal data, object to or restrict some processing, withdraw consent, and nominate someone to exercise your rights. Email <!-- -->work.techhacksai@gmail.com<!-- -->; we reply within 30 days. You can also complain to your local data protection authority.</p><p>You can edit your name in Settings, delete projects in the studio, revoke paired computers in Settings, and ask us to delete your account.</p></div></section><section id="security" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#security" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">10. Security</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Data is encrypted in transit (HTTPS) and at rest by our storage providers. Each account’s data is isolated with database row-level security, files are private and served only through short-lived signed links, and Companion tokens are hashed and revocable. No system is perfectly secure; if a breach affects you we will notify you and the authorities as the law requires.</p></div></section><section id="children" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#children" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">11. Children</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Captionit<!-- --> is not directed at children under <!-- -->13<!-- -->, and we do not knowingly collect their data. If you believe a child has given us data, contact us and we will delete it.</p></div></section><section id="cookies" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#cookies" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">12. Cookies and local storage</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>We use only what is needed to keep you signed in and remember a few editor preferences. Our analytics (Vercel Analytics and Speed Insights) record page visits and a few product events without setting cookies. If advertising is enabled, Google and its partners may also set advertising cookies as described in section 8. See the <a href="/cookies">Cookie Policy</a>.</p></div></section><section id="changes" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#changes" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">13. Changes</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>We will update this policy as the service changes and tell you about material changes by email or in the app before they apply. The effective date at the top shows the current version.</p></div></section><section id="contact" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#contact" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">14. Contact and grievance officer</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>Privacy questions and requests: <!-- -->work.techhacksai@gmail.com<!-- -->. <!-- -->Parvez Achhan Ali Siddiqui, an individual (sole proprietor) trading as Captionit<!-- -->, <!-- -->India<!-- -->.</p></div></section></div><p class="mt-14 rounded-2xl border border-obsidian/10 bg-muted-beige/40 p-5 text-sm leading-relaxed text-obsidian/70">Questions about this document? Write to <strong class="text-obsidian">work.techhacksai@gmail.com</strong>. <!-- -->Parvez Achhan Ali Siddiqui, an individual (sole proprietor) trading as Captionit<!-- -->, <!-- -->India<!-- -->.</p></article><!--$--><!--/$--></main></div><footer class="relative overflow-hidden border-t border-[#FFFFEB]/10 bg-[#1E1E1B] pt-20 pb-10 text-[#FFFFEB]"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 lg:gap-16 pb-16"><div class="space-y-4"><h3 class="font-mono text-xs font-bold uppercase tracking-widest text-[#FFFFEB]/50">Product</h3><ul class="space-y-0.5 text-sm text-[#FFFFEB]/75 lg:space-y-2.5"><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#how">How it works</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/pricing">Pricing</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/auto-caption-generator">Auto caption generator</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/transcribe">Transcribe</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#looks">Looks gallery</a></li><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#control">Precision controls</a></li></ul></div><div class="space-y-4"><h3 class="font-mono text-xs font-bold uppercase tracking-widest text-[#FFFFEB]/50">For creators</h3><ul class="space-y-0.5 text-sm text-[#FFFFEB]/75 lg:space-y-2.5"><li><a class="inline-flex min-h-10 items-center transition-colors hover:text-[#34D399] hover:underline underline-offset-4 lg:min-h-0" href="/#looks">Looks for Shorts,