 Server Cost · Local Hardware-Accelerated Rendering</span></div></div></footer></div><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--><script src="/_next/static/chunks/1hah25pdzvuw4.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:I[411510,[\"/_next/static/chunks/0kyyuhn1-sds-.js\",\"/_next/static/chunks/0kcypk-dikks4.js\"],\"default\"]\n3:I[301487,[\"/_next/static/chunks/11achr2dze1yq.js\",\"/_next/static/chunks/0vjf7-qx5qdy3.js\"],\"default\"]\n4:I[99587,[\"/_next/static/chunks/0kyyuhn1-sds-.js\",\"/_next/static/chunks/0kcypk-dikks4.js\",\"/_next/static/chunks/3klag434yhojx.js\"],\"default\"]\n5:I[146817,[\"/_next/static/chunks/11achr2dze1yq.js\",\"/_next/static/chunks/0vjf7-qx5qdy3.js\"],\"default\"]\n6:I[684287,[\"/_next/static/chunks/0kyyuhn1-sds-.js\",\"/_next/static/chunks/0kcypk-dikks4.js\",\"/_next/static/chunks/3ob6gt1ulhx0u.js\",\"/_next/static/chunks/2cdnrh489pccc.js\",\"/_next/static/chunks/277yxg84c-bqb.js\",\"/_next/static/chunks/0fj1njqm0y_bz.js\",\"/_next/static/chunks/0xwa7l3-xukxe.js\",\"/_next/static/chunks/2gj3y6z__k60y.js\"],\"\"]\ne:I[575344,[\"/_next/static/chunks/0kyyuhn1-sds-.js\",\"/_next/static/chunks/0kcypk-dikks4.js\",\"/_next/static/chunks/2wkn11hc4eie7.js\"],\"default\"]\n:HL[\"/_next/static/chunks/2ifkwjg7b6d0t.css\",\"style\"]\n:HL[\"/_next/static/chunks/278_yv101xrfo.css\",\"style\"]\n:HL[\"/_next/static/media/7ebf22b5a21034f8-s.p.3j3877k49yy0l.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/e41d5df559864f9e-s.p.1g73gv09-xcb6.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/fba5a26ea33df6a3-s.p.18rizl4rsrl42.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n"])</script><script>self.__next_f.push([1,"0:{\"P\":null,\"c