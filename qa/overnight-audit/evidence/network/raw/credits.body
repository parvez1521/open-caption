pe="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-icon.png?apple-icon.1zg5civk715du.png" sizes="180x180" type="image/png"/><script>(function(){try{
var hsh=location.hash||"",q=location.search||"";
var isReturn=/(^|[#&])(access_token|error_description)=/.test(hsh)||/[?&]code=[^&]{20,}/.test(q);
if(!isReturn||location.pathname==="/reset-password")return;
// password-reset links carry a session too: they belong on /reset-password, never the studio
if(/[#&]type=recovery/.test(hsh)){location.replace("/reset-password"+hsh);return}
var canon="https://www.captionit.in";
var host=location.hostname;
var wrongHost=/.vercel.app$/.test(host)&&canon.indexOf("//"+host)<0&&/[#&]access_token=/.test(hsh);
if(wrongHost){location.replace(canon+"/start"+hsh);return}
if(location.pathname!=="/start"){location.replace("/start"+q+hsh)}
}catch(e){}})();</script><script>(function(){try{
var h=document.documentElement;if(location.pathname!=="/")return;
var k="ce_intro",force=false||/[?&]intro\b/.test(location.search);
if(!force&&(sessionStorage.getItem(k)||matchMedia("(pointer:coarse)").matches)){h.dataset.intro="skip";return}
try{sessionStorage.setItem(k,"1")}catch(e){}
h.dataset.intro="play";
var started=false;
function go(){if(started)return;started=true;requestAnimationFrame(function(){requestAnimationFrame(function(){
h.classList.add("ce-go");
setTimeout(function(){h.classList.add("ce-a-done")},2300);
setTimeout(function(){h.classList.add("ce-out")},6000);
})})}
function wait(){if(!document.querySelector(".ce-intro")){requestAnimationFrame(wait);return}
var f=document.fonts&&document.fonts.ready;if(f){Promise.race([f,new Promise(function(r){setTimeout(r,900)})]).then(go)}else go()}
wait();setTimeout(go,2500);
}catch(e){}})();</script><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="h-full bg-major text-obsidian font-sans selection:bg-emerald-accent selection:text-[#141412]"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="skip-link">Skip to main content</a><div class="min-h-screen bg-major text-obsidian"><header class="sticky top-0 z-30 border-b border-obsidian/10 bg-major"><div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4"><a aria-label="Captionit home" href="/"><span class="inline-flex shrink-0 select-none items-center gap-2 " role="img" aria-label="Captionit"><img src="/brand/opencaption-icon-light.svg" alt="" aria-hidden="true" height="26" class="block shrink-0 select-none" style="height:26px;width:auto" draggable="false"/><span class="font-styled font-black leading-none tracking-tight" style="font-size:21.32px">Caption<span class="font-serif font-normal italic">it</span></span></span></a><a class="rounded-full bg-obsidian px-4 py-2 text-sm font-semibold text-major transition hover:bg-obsidian/85" href="/start">Start free</a></div></header><div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:py-16"><nav aria-label="Legal documents" class="min-w-0 lg:sticky lg:top-24 lg:self-start"><p class="mb-3 hidden text-xs font-semibold uppercase tracking-wider text-obsidian/50 lg:block">Legal</p><ul class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] lg:mx-0 lg:flex-col lg:gap-1 lg:overflow-visible lg:px-0"><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/about">About</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/terms">Terms of Service</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/privacy">Privacy Policy</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/cookies">Cookie Policy</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/acceptable-use">Acceptable Use</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/copyright">Copyright &amp; Takedowns</a></li><li class="shrink-0"><a class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian/15 text-obsidian/70 hover:bg-muted-beige/60 hover:text-obsidian" href="/subprocessors">Subprocessors</a></li><li class="shrink-0"><a aria-current="page" class="block whitespace-nowrap rounded-full border px-3 py-2 text-sm transition lg:rounded-lg lg:border-0 lg:px-3 lg:py-2 border-obsidian bg-obsidian text-major lg:bg-emerald-accent lg:text-[#141412]" href="/credits">Credits &amp; Licences</a></li></ul></nav><main id="main-content" class="min-w-0"><article class="max-w-3xl"><p class="text-xs font-semibold uppercase tracking-wider text-obsidian/50">Effective <!-- -->30 September 2026</p><h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Footage<!-- --> <em class="text-obsidian/70">credits</em></h1><div class="mt-5 text-lg leading-relaxed text-obsidian/75">The talking-head clips on the home page come from Wikimedia Commons under the licences below. Each was trimmed, cropped, transcribed and captioned with Captionit; the captions are our addition and are shared under the same licence as the clip.</div><div class="mt-10 space-y-10"><section id="hero" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#hero" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">Home page clips</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><ul class="space-y-3"><li><a href="https://commons.wikimedia.org/wiki/File:Peru_Testimonial_-_Sol_Luciana.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Peru Testimonial - Sol Luciana</a><span class="text-obsidian/60"> · <!-- -->CC BY 3.0<!-- --> · captioned with the <!-- -->3-Line Stagger<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:Peru_Testimonial_-_Gianna_Garcia.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Peru Testimonial - Gianna Garcia</a><span class="text-obsidian/60"> · <!-- -->CC BY 3.0<!-- --> · captioned with the <!-- -->Jumping Box<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:Peru_Testimonial_-_Jesse_Vilela.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Peru Testimonial - Jesse Vilela</a><span class="text-obsidian/60"> · <!-- -->CC BY 3.0<!-- --> · captioned with the <!-- -->3-Line Glow Hero<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:Wikinights_testimonial_by_Aisha.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Wikinights testimonial by Aisha</a><span class="text-obsidian/60"> · <!-- -->CC BY-SA 4.0<!-- --> · captioned with the <!-- -->Bouncy Single Word<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:Wikipedians_speak_-_Konkani_Wikipedian_Rusita_Paryekar-en_1080p.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Wikipedians speak - Konkani Wikipedian Rusita Paryekar</a><span class="text-obsidian/60"> · <!-- -->CC BY-SA 3.0<!-- --> · captioned with the <!-- -->Giant Italic Hero<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:WIKITONGUES-_William_speaking_English.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">WIKITONGUES- William speaking English</a><span class="text-obsidian/60"> · <!-- -->CC BY-SA 4.0<!-- --> · captioned with the <!-- -->Comic Tilt<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:WIKITONGUES-_Sam_speaking_English.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">WIKITONGUES- Sam speaking English</a><span class="text-obsidian/60"> · <!-- -->CC BY-SA 4.0<!-- --> · captioned with the <!-- -->Script Hero Pop<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:WIKITONGUES-_Gereon_speaking_English.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">WIKITONGUES- Gereon speaking English</a><span class="text-obsidian/60"> · <!-- -->CC BY-SA 4.0<!-- --> · captioned with the <!-- -->Underline Sweep<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:WIKITONGUES-_Mckensie_speaking_English.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">WIKITONGUES- Mckensie speaking English</a><span class="text-obsidian/60"> · <!-- -->CC BY-SA 4.0<!-- --> · captioned with the <!-- -->Kinetic Big Word<!-- --> look</span></li><li><a href="https://commons.wikimedia.org/wiki/File:WIKITONGUES-_Omar_Speaking_English_and_Jamaican_Patois.webm" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">WIKITONGUES- Omar Speaking English and Jamaican Patois</a><span class="text-obsidian/60"> · <!-- -->CC BY 3.0<!-- --> · captioned with the <!-- -->Yellow Highlighter<!-- --> look</span></li></ul></div></section><section id="stock-sfx" class="scroll-mt-24"><h2 class="text-xl font-bold tracking-tight sm:text-2xl"><a href="#stock-sfx" class="hover:underline hover:decoration-orange-accent hover:decoration-2 hover:underline-offset-4">Bundled sound effects</a></h2><div class="mt-3 space-y-3 leading-relaxed text-obsidian/80 [&amp;_a]:font-medium [&amp;_a]:underline [&amp;_a]:decoration-orange-accent [&amp;_a]:decoration-2 [&amp;_a]:underline-offset-4 [&amp;_li]:ml-5 [&amp;_li]:list-disc [&amp;_li]:pl-1 [&amp;_strong]:text-obsidian [&amp;_ul]:space-y-1.5"><p>The starter pack&#x27;s files are CC0 (public domain) works by the authors below, recorded per file at ingestion. The meme sounds are our own original synthesized effects — generated in code in the style of the classic sounds, never copies of the famous recordings — and are likewise dedicated CC0. CC0 needs no attribution — these credits are kept so the record stays checkable. The same record travels with each copy added to a project&#x27;s media bin.</p><ul class="space-y-3"><li><a href="https://kenney.nl/assets/interface-sounds" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Interface Sounds — click_001</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/ui-audio" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">UI Audio — mouseclick1</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/interface-sounds" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Interface Sounds — drop_001</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/interface-sounds" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Interface Sounds — tick_001</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/interface-sounds" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Interface Sounds — confirmation_001</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/digital-audio" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Digital Audio — twoTone1</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/music-jingles" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Music Jingles — jingles_PIZZI00</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/digital-audio" class="font-semibold underline underline-offset-2" target="_blank" rel="noreferrer">Digital Audio — phaserUp1</a><span class="text-obsidian/60"> · <!-- -->Kenney<!-- --> · <!-- -->CC0 1.0<!-- --> · retrieved <!-- -->2026-11-10</span></li><li><a href="https://kenney.nl/assets/digital-audio" class="font-semibold underline underli